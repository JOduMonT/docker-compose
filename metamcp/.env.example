# MetaMCP — local standalone (bundled Postgres). Copy to .env and edit.

METAMCP_PORT=12008
METAMCP_APP_URL=http://localhost:12008

# Bundled Postgres. Defaults are fine for a loopback-only local instance.
METAMCP_POSTGRES_HOST=metamcp-postgres
METAMCP_POSTGRES_PORT=5432
METAMCP_POSTGRES_USER=metamcp_user
METAMCP_POSTGRES_PASSWORD=m3t4mcp
METAMCP_POSTGRES_DB=metamcp_db

# REQUIRED — no default, the stack refuses to start without it.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=changeme
