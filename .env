# ==============================================================================
# GLOBAL DEFAULT ENVIRONMENT VARIABLES
# ==============================================================================
# Values here are the base defaults. To override them for your local machine,
# copy this file to .env.local and make your changes there.
# Do NOT commit .env.local to git.

# Container User/Group Permissions
PUID=1000
PGID=100

# Local Timezone
TZ=Europe/Paris

# ==============================================================================
# SERVICE PORTS
# ==============================================================================
SEARXNG_PORT=8888
QBITTORRENT_PORT=8080
FLARESOLVERR_PORT=8191
CHANGEDETECTION_PORT=5000

# ==============================================================================
# STORAGE PATHS
# ==============================================================================
# Local media directory bindings
MEDIA_BOOKS=/mnt/WD1000/Books
MEDIA_MUSIC=/mnt/WD1000/Music
MEDIA_SHOWS=/mnt/WD1000/Shows
MEDIA_MOVIES=/mnt/WD1000/Movies

# Local downloads folder
DOWNLOADS_DIR=/home/shared/Downloads
